<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Commitments.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Use the local tsconfig.json for MSBuild-driven TypeScript compilation -->
    <TypeScriptConfig>tsconfig.json</TypeScriptConfig>
    <!-- Ensure MSBuild uses a recent TypeScript tools version; this is independent of npm tooling -->
    <TypeScriptToolsVersion>5.0</TypeScriptToolsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- TypeScript sources for MSBuild to compile; tests are excluded -->
    <TypeScriptCompile Include="src\**\*.ts"
                       Exclude="node_modules\**\*;**\*.spec.ts" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSBuild integration for tsc; does not affect npm-based Angular builds -->
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.6.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
