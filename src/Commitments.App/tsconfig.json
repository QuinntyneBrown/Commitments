{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "strict": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ES2022",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ],
    "types": [],
    "paths": {
      "@app/*": ["projects/commitments-app/src/app/*"],
      "@core/*": ["projects/commitments-app/src/app/core/*"],
      "@models/*": ["projects/commitments-app/src/app/models/*"],
      "@services/*": ["projects/commitments-app/src/app/services/*"],
      "@components/*": ["projects/commitments-app/src/app/components/*"],
      "@pages/*": ["projects/commitments-app/src/app/pages/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "strictTemplates": false
  }
}
