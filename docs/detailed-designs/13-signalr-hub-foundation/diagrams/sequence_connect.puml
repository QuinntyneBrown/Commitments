@startuml sequence_connect
!theme plain
skinparam sequenceMessageAlign center

title Hub Connect (with profile group join)

actor Owner
participant "SPA\nHubClient" as FE
participant "/hub upgrade" as UP
participant "JwtQueryString\nMiddleware" as MW
participant "JWT Auth" as AUTH
participant "CommitmentsHub" as HUB

Owner -> FE: navigate to protected route
FE -> UP: GET /hub?token=jwt&profileId=p1
UP -> MW: HTTP request
MW -> MW: copy ?token to Authorization\ncopy ?profileId to ProfileId header
MW -> AUTH: forward
AUTH -> AUTH: validate JWT
AUTH -> HUB: upgrade accepted
HUB -> HUB: GetProfileId() = p1
HUB -> HUB: AddToGroup("profile:p1")
HUB --> FE: WebSocket open
FE --> Owner: messages$ ready

@enduml
