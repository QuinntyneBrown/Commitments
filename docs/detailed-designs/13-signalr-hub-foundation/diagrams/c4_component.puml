@startuml c4_component
!theme plain
!include <C4/C4_Component>

title SignalR Hub Foundation - API Components

Container_Boundary(api, "Commitments.Api host") {
    Component(prog, "Program.cs", "C#", "Adds SignalR; maps /hub")
    Component(mw, "JwtQueryStringAuthMiddleware", "C#", "Promotes ?token= to Authorization for /hub")
    Component(authn, "JWT Bearer Auth", "ASP.NET Core", "Validates token")
    Component(hubcls, "CommitmentsHub", "Hub", "OnConnectedAsync joins profile group")
    Component(ping, "HubPingController (dev)", "MVC controller", "POST /api/v1.0/dev/hub-ping")
    Component(ctx, "IHubContext<CommitmentsHub>", "ASP.NET Core SignalR", "Server-side send API")
}

Rel(prog, mw, "Registers")
Rel(prog, authn, "Registers")
Rel(prog, hubcls, "Maps /hub")
Rel(mw, authn, "Forwards request")
Rel(hubcls, ctx, "Joins group")
Rel(ping, ctx, "Sends 'message'")

@enduml
