@startuml c4_container
!theme plain
!include <C4/C4_Container>

title SignalR Hub Foundation - Container Diagram

Person(owner, "Profile Owner", "Browser session")

System_Boundary(client, "Browser") {
    Container(spa, "Commitments SPA", "Angular 18", "HubClient holds WebSocket")
}

System_Boundary(server, "Commitments.Api host") {
    Container(api, "Web API", "ASP.NET Core 9", "Controllers + middleware")
    Container(hub, "SignalR Hub /hub", "ASP.NET Core SignalR", "CommitmentsHub")
}

ContainerDb(sql, "SQL Server", "Users + Profiles")

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "REST + JWT", "JSON/HTTPS")
Rel(spa, hub, "WebSocket upgrade", "WSS + ?token")
Rel(api, sql, "Validates JWT against", "SQL")
Rel(hub, sql, "(none in this slice)", "-")

@enduml
