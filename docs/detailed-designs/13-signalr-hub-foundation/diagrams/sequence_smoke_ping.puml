@startuml sequence_smoke_ping
!theme plain
skinparam sequenceMessageAlign center

title Smoke Ping (dev-only, ATDD screenshot)

actor Dev as "Backend\nDeveloper"
participant "Swagger UI" as SW
participant "HubPing\nController" as CTL
participant "IHubContext" as CTX
participant "Browser\nWebSocket" as WS
participant "SPA\nHubClient" as FE

Dev -> SW: POST /api/v1.0/dev/hub-ping\n{text:"hello"}
SW -> CTL: invoke
CTL -> CTL: GetProfileId() = p1
CTL -> CTX: Clients.Group("profile:p1")\n.SendAsync("message", {event:"hubPing", text:"hello"})
CTX -> WS: WebSocket frame
WS -> FE: on('message', value)
FE -> FE: messages$.next(value)
FE --> Dev: DevTools shows frame

@enduml
