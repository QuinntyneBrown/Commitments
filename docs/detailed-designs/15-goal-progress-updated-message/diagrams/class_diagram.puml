@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title goalProgressUpdated - Domain Model

class IntegrationEvent {
    +Id: Guid
    +OccurredOn: DateTime
}

class ActivityRecordedEvent {
    +ActivityId: Guid
    +BehaviourId: Guid
    +ProfileId: Guid
    +PerformedOn: DateTimeOffset
    +Reason: ActivityChangeReason
}

enum ActivityChangeReason {
    Created
    Updated
    Deleted
}

class GoalProgressUpdatedPayload <<record>> {
    +GoalId: Guid
    +BehaviourId: Guid?
    +Count: int
    +Target: int
    +Percent: int
    +AsOf: DateTimeOffset
    +Date: DateOnly
    +Reason: string
    +SourceActivityId: Guid?
}

class GoalProgressUpdatedRealtimeNotifier <<HostedService>> {
    -bus: IEventBus
    -scope: IServiceScopeFactory
    -publisher: IRealtimePublisher
    +HandleAsync(evt): Task
}

IntegrationEvent <|-- ActivityRecordedEvent
ActivityRecordedEvent --> ActivityChangeReason
GoalProgressUpdatedRealtimeNotifier --> ActivityRecordedEvent : subscribes
GoalProgressUpdatedRealtimeNotifier --> GoalProgressUpdatedPayload : constructs

@enduml
