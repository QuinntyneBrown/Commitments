@startuml sequence_live_update
!theme plain
skinparam sequenceMessageAlign center

title Activity Created -> Live Tile Updates

actor B as "Recorder\n(browser B)"
actor A as "Owner\n(browser A)"
participant "ActivityController" as AC
participant "SaveActivity\nHandler" as SH
participant "InMemoryEventBus" as BUS
participant "GoalProgress\nNotifier" as NOT
participant "IRealtime\nPublisher" as PUB
participant "/hub" as HUB
participant "LiveGoalMetrics\nController" as CTRL
participant "LiveGoalMetrics\nTileComponent" as TILE

B -> AC: POST /api/v1.0/activity
AC -> SH: Send(SaveActivityRequest)
SH -> SH: SaveChangesAsync
SH -> BUS: PublishAsync(ActivityRecordedEvent)
BUS -> NOT: HandleAsync(evt)
NOT -> NOT: query Count(*) for today
NOT -> PUB: PublishToProfileAsync(\n  evt.ProfileId,\n  'goalProgressUpdated',\n  payload)
PUB -> HUB: Group('profile:{id}')\n.SendAsync('message', envelope)
HUB -> A: WSS frame
A -> CTRL: on('goalProgressUpdated')\n=> payload
CTRL -> CTRL: filter goalId\nset count, asOf, last14
CTRL -> TILE: signals updated
TILE --> A: re-render

@enduml
