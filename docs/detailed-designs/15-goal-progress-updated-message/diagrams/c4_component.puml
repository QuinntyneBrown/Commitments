@startuml c4_component
!theme plain
!include <C4/C4_Component>

title goalProgressUpdated - Components

Container_Boundary(api, "Commitments.Api") {
    Component(svc, "SaveActivityCommandHandler", "MediatR", "writes Activity, publishes event")
    Component(rsv, "RemoveActivityCommandHandler", "MediatR", "deletes Activity, publishes event")
    Component(evt, "ActivityRecordedEvent", "record in Shared", "ProfileId, BehaviourId, Reason")
    Component(notif, "GoalProgressUpdated\nRealtimeNotifier", "IHostedService", "subscribes to bus")
    Component(payload, "GoalProgressUpdatedPayload", "record", "wire DTO")
    Component(pub, "IRealtimePublisher", "abstraction", "envelope + group send")
}

Container_Boundary(spa, "Commitments SPA") {
    Component(client, "HubClient.on<T>", "Angular service", "typed stream")
    Component(ctrl, "LiveGoalMetricsController", "Angular service", "filter by goalId, set signals")
    Component(comp, "LiveGoalMetricsTileComponent", "Angular standalone", "displays count/target/pct")
}

Rel(svc, evt, "publishes")
Rel(rsv, evt, "publishes")
Rel(evt, notif, "delivered")
Rel(notif, payload, "constructs")
Rel(notif, pub, "PublishToProfileAsync")
Rel(pub, client, "WSS envelope")
Rel(client, ctrl, "GoalProgressUpdatedPayload")
Rel(ctrl, comp, "Signals")

@enduml
