@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Goal Metrics (merged) - Components

Container_Boundary(plugin, "commitments-dashboard-plugin") {
  Component(tile, "GoalMetricsTileComponent", "Angular component", "Shell + pill + ring + (review only) date+delta")
  Component(ctrl, "GoalMetricsController", "Injectable", "Signals: mode/current/today/percentage/deltaLabel")
  Component(svc, "GoalProgressService", "Angular service", "getCurrent, getAt")
  Component(hub, "HubClient", "Angular service", "on<GoalProgressUpdated>")
}

Container_Boundary(ui, "commitments-ui") {
  Component(shell, "TileShellComponent", "Angular component", "Header/eyebrow/status/body")
  Component(pill, "StatusPillComponent", "Angular component", "LIVE | REVIEW")
  Component(ring, "ProgressRingComponent", "Angular component", "count/target ring")
  Component(delta, "DeltaBadgeComponent", "Angular component", "+N/-N vs today")
}

Container_Boundary(framework, "dashboard-framework") {
  Component(ctx, "TILE_CONTEXT", "DI token", "mode, selectedReviewDate")
  Component(bind, "bindTileMode()", "Function", "load + effect on mode/asOf")
  Component(reg, "TileRegistryService", "Angular service", "Deny-list legacy ids")
}

Rel(tile, ctx, "inject(optional)")
Rel(tile, bind, "bindTileMode")
Rel(tile, hub, "Subscribe (mode==='live' only)")
Rel(bind, ctrl, "load(mode, asOf)")
Rel(ctrl, svc, "getCurrent / getAt")
Rel(tile, shell, "Renders")
Rel(shell, pill, "Embeds")
Rel(shell, ring, "Embeds")
Rel(shell, delta, "Embeds (review only)")

@enduml
