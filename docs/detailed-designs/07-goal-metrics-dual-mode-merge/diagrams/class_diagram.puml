@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Goal Metrics (merged) - Domain Model

class GoalMetricsTileComponent {
  +tileMetadata: TileMetadata
  +goalId: string
  -context: TileContext
  -controller: GoalMetricsController
  -hubSubscription: Subscription|null
}

class GoalMetricsController {
  +mode: Signal<DashboardMode>
  +current: Signal<GoalProgressDto|null>
  +today: Signal<GoalProgressDto|null>
  +count: Signal<number>
  +target: Signal<number>
  +percentage: Signal<number>
  +dateLabel: Signal<string>
  +deltaLabel: Signal<string|null>
  +deltaTone: Signal<'success'|'warn'|'neutral'>
  +load(mode, asOf): void
  +applyHubUpdate(evt): void
}

class GoalProgressService {
  +getCurrent(goalId): Observable<GoalProgressDto>
  +getAt(goalId, asOf): Observable<GoalProgressDto>
}

class GoalProgressDto {
  +goalId: string
  +count: number
  +target: number
  +asOf: string
}

class GoalProgressUpdated {
  +goalId: string
  +count: number
  +asOf: string
}

class LiveGoalMetricsTileComponent <<deprecated>> { }
class ReviewGoalHistoryTileComponent <<deprecated>> { }

GoalMetricsTileComponent o-- GoalMetricsController
GoalMetricsController --> GoalProgressService
GoalProgressService ..> GoalProgressDto
GoalMetricsController ..> GoalProgressUpdated : applyHubUpdate
GoalMetricsTileComponent ..> LiveGoalMetricsTileComponent : replaces
GoalMetricsTileComponent ..> ReviewGoalHistoryTileComponent : replaces

@enduml
