@startuml c4_context
!theme plain
!include <C4/C4_Context>

title Goal Metrics (merged) - System Context

Person(user, "User")

System_Boundary(sys, "Commitments App") {
  System(spa, "Angular SPA", "Hosts merged GoalMetricsTileComponent")
  System(api, "Commitments API", "GetGoalProgress + GetGoalProgressAt + goalProgressUpdated push")
}

System_Ext(db, "SQL Server", "Goals + Achievements per profile")
System_Ext(signalr, "SignalR Hub", "goalProgressUpdated, dashboardTileDataInvalidated")

Rel(user, spa, "Mode toggle, scrub")
Rel(spa, api, "GET /goal-progress/current; GET /goal-progress/at?asOf")
Rel(spa, signalr, "goalProgressUpdated (live only)")
Rel(api, db, "Single COUNT query")
Rel(api, signalr, "Publishes goalProgressUpdated")

@enduml
