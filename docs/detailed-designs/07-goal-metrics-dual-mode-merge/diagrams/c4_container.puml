@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Goal Metrics (merged) - Containers

Person(user, "User")

System_Boundary(spa, "Angular SPA") {
  Container(plugin, "commitments-dashboard-plugin", "Angular lib", "GoalMetricsTileComponent + Controller")
  Container(framework, "dashboard-framework", "Angular lib", "TileContext, bindTileMode, registry deny-list")
  Container(hub, "HubClient", "Angular service", "goalProgressUpdated subscription (live only)")
}

System_Boundary(api, "Commitments.Api Host") {
  Container(commit, "Commitments Module", ".NET 9", "GetGoalProgress + GetGoalProgressAt (existing)")
  Container(realtime, "Realtime", "ASP.NET", "GoalProgressUpdatedRealtimeNotifier")
}

ContainerDb(db, "SQL Server", "RDBMS", "Goals + Achievements")

Rel(user, plugin, "Sees ring + LIVE/REVIEW pill + delta in Review")
Rel(plugin, framework, "TILE_CONTEXT, bindTileMode")
Rel(plugin, hub, "Subscribe / unsubscribe by mode")
Rel(plugin, commit, "GET /goal-progress/current and /at?asOf", "JSON")
Rel(commit, db, "Single SELECT COUNT per request", "SQL")
Rel(realtime, hub, "goalProgressUpdated", "WebSocket")

@enduml
