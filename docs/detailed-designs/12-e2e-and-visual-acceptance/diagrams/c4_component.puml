@startuml c4_component
!theme plain
!include <C4/C4_Component>

title E2E POM - Component Diagram

Container_Boundary(pom, "Page Object Model") {
    Component(dash, "DashboardPage", "TS class", "Top-level locators + actions")
    Component(toggle, "ModeTogglePo", "TS class")
    Component(scrub, "ScrubberPo", "TS class")
    Component(live, "LiveMetricTilePo", "TS class")
    Component(chart, "ChartTilePo", "TS class")
    Component(review, "ReviewTilePo", "TS class")
