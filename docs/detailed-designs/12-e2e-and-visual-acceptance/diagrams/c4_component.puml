}

Rel(dash, toggle, "exposes")
Rel(dash, scrub, "exposes")
Rel(dash, live, "exposes")
Rel(dash, chart, "exposes")
Rel(dash, review, "exposes")
Rel(dash, seed, "uses on test setup")

@enduml
