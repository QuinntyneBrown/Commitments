@startuml sequence_compose
!theme plain
skinparam sequenceMessageAlign center

title Compose New Commitment - boundary assertions

actor Spec
participant Po as "CommitmentsPagePo"
participant Browser
participant Page as "CommitmentsPageComponent"
participant Dlg as "EditCommitmentDialog"
participant BehSvc as "BehaviourService\n(peer)"
participant Svc as "CommitmentService"
participant Mock as "MockDashboardBackendService"
participant Bridge as "WindowFeatureBridgeService"

Spec -> Po: pom.goto()
Po -> Browser: page.goto('/commitments')
Browser -> Page: ngOnInit()
Page -> Svc: list({skip:0, take:5})
Svc -> Mock: get('api/v1.0/commitments', {skip:0, take:5})
Mock -> Bridge: recordBackend(get with params)
Mock --> Svc: {commitments, count:12}

Spec -> Po: pom.openAdd()
Po -> Browser: click "Add"
Page -> Dlg: open
Dlg -> BehSvc: list()
BehSvc -> Mock: get('api/v1.0/behaviours')
Mock -> Bridge: recordBackend(get behaviours)

Spec -> Dlg: choose behaviour, set frequencies
Spec -> Dlg: submit
Dlg -> Svc: save(input)
Svc -> Mock: post('api/v1.0/commitments', body)
Mock -> Bridge: recordBackend(post)

Spec -> Po: pom.backendCalls()
Po --> Spec: [get, get, post]
Spec -> Spec: expect param shapes + body

@enduml
