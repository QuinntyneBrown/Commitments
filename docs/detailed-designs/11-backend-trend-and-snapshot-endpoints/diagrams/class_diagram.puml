@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Goal Progress - Domain + DTOs

class Goal {
    +Id: int
    +ProfileId: Guid
    +Target: int
    +CreatedAt: DateTimeOffset
}

class Achievement {
    +Id: int
    +ProfileId: Guid
    +GoalId: int
    +RecordedAt: DateTimeOffset
}

class GoalProgressDto <<record>> {
    +GoalId: int
    +Target: int
    +Count: int
    +AsOf: DateTimeOffset
}

class GoalTrendDto <<record>> {
    +GoalId: string
    +Mode: string
    +AsOf: DateTimeOffset
    +WindowDays: int
    +Points: GoalTrendPointDto[]
    +CurrentPercentage: int
    +PeakPercentage: int
    +LowPercentage: int
    +DeltaLabel: string
}

class GoalTrendPointDto <<record>> {
    +Date: string
    +Completed: int
    +Target: int
    +Percentage: int
}

Goal "1" -- "*" Achievement
GoalTrendDto "1" -- "*" GoalTrendPointDto

@enduml
