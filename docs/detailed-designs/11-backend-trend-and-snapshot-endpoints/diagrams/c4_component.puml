@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Goal Progress Endpoints - Component Diagram

Container_Boundary(api, "Commitments.Api / Commitments module") {
    Component(ctrl, "GoalProgressController", "ASP.NET Core controller", "/current /at /trend")
    Component(h1, "GetGoalProgressHandler", "MediatR", "Today count")
    Component(h2, "GetGoalProgressAtHandler", "MediatR", "Count <= asOf")
    Component(h3, "GetGoalProgressTrendHandler", "MediatR", "Window join + group by date")
    Component(val, "ValidationBehavior", "MediatR pipeline", "FluentValidation")
    Component(db, "CommitmentsDbContext", "EF Core DbContext", "Goals + Achievements")
}

Rel(ctrl, h1, "send")
Rel(ctrl, h2, "send")
Rel(ctrl, h3, "send")
Rel(h1, db, "Query")
Rel(h2, db, "Query")
Rel(h3, db, "Query")
Rel(val, h1, "validates")
Rel(val, h2, "validates")
Rel(val, h3, "validates")

@enduml
