@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Backend Endpoints - Container Diagram

Person(user, "Profile Owner")
System_Boundary(spa, "Commitments SPA") {
    Container(plugin, "commitments-dashboard-plugin", "Angular library", "Calls /current, /at, /trend")
}
System_Boundary(svr, "Commitments.Api") {
    Container(api, "GoalProgressController", "ASP.NET Core 9", "3 read endpoints")
    ContainerDb(db, "SQL Server", "Goals + Achievements")
}

Rel(user, spa, "Uses")
Rel(spa, api, "JSON over HTTPS")
Rel(api, db, "EF Core, bounded queries")

@enduml
