@startuml sequence_live_trend
!theme plain
skinparam sequenceMessageAlign center

title Live Trend Request

participant Client as C
participant GoalProgressController as Ctrl
participant GetGoalProgressTrendHandler as H
database "SQL Server" as DB

C -> Ctrl: GET /trend?goalId=17&windowDays=30
Ctrl -> Ctrl: validate (windowDays in [1,365], asOf=now)
Ctrl -> H: send(query)
H -> DB: window CTE + LEFT JOIN GROUP BY
DB --> H: 30 rows
H -> H: map to DTO + delta label
H --> Ctrl: GoalTrendDto
Ctrl -> Ctrl: set Cache-Control: no-store
Ctrl --> C: 200 OK

@enduml
