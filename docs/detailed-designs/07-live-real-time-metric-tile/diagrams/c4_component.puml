@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Live Real-Time Metric Tile - Component Diagram

Container_Boundary(plugin, "commitments-dashboard-plugin") {
    Component(comp, "LiveGoalMetricsTileComponent", "Angular standalone", "Renders chrome + bars")
    Component(ctrl, "LiveGoalMetricsController", "Angular @Injectable", "Signals + lifecycle")
    Component(svc, "GoalProgressService", "Angular @Injectable", "getCurrent / getLast14")
    Component(hubcli, "HubClient", "Angular @Injectable", "Existing SignalR adapter")
}

Container_Boundary(api, "Commitments.Api") {
    Component(ctrlApi, "GoalProgressController", "ASP.NET Core controller", "/current + /last14")
    Component(h1, "GetGoalProgressHandler", "MediatR", "From Feature 01")
    Component(h2, "GetGoalProgressLast14Handler", "MediatR", "Group by day")
}

Rel(comp, ctrl, "Reads signals")
Rel(ctrl, svc, "HTTP calls")
Rel(ctrl, hubcli, "on('goalProgressUpdated')")
Rel(svc, ctrlApi, "GET /current, /last14")
Rel(ctrlApi, h1, "send")
Rel(ctrlApi, h2, "send")

@enduml
