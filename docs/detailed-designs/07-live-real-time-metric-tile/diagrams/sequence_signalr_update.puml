@startuml sequence_signalr_update
!theme plain
skinparam sequenceMessageAlign center

title SignalR Update

participant "Other Tab" as Tab
participant "Commitments.Api" as Api
participant "SignalR Hub" as Hub
participant LiveGoalMetricsController as Ctrl
participant LiveGoalMetricsTileComponent as Comp

Tab -> Api: POST /achievements
Api -> Hub: clients.group('profile:'+pid)\n.send('goalProgressUpdated', {goalId, count, asOf})
Hub --> Ctrl: 'goalProgressUpdated'
Ctrl -> Ctrl: count.set(new), lastUpdatedAt.set(asOf)
Ctrl -> Ctrl: patch last14[13] today
Comp -> Comp: re-render bar + delta + pulse pill

@enduml
