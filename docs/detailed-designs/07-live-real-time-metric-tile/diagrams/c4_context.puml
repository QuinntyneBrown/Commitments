@startuml c4_context
!theme plain
!include <C4/C4_Context>

title Live Real-Time Metric Tile - System Context

Person(user, "Profile Owner")
System(spa, "Commitments SPA")
System(api, "Commitments.Api", "ASP.NET Core")
System_Ext(hub, "SignalR Hub", "Pushes goalProgressUpdated")

Rel(user, spa, "Views live tile")
Rel(spa, api, "GET /api/goal-progress/current, /last14", "JSON")
Rel(spa, hub, "Subscribes goalProgressUpdated", "WebSocket")
Rel(api, hub, "Publishes events")

@enduml
