@startuml sequence_initial_render
!theme plain
skinparam sequenceMessageAlign center

title Initial Render

actor User
participant LiveGoalMetricsTileComponent as Comp
participant LiveGoalMetricsController as Ctrl
participant GoalProgressService as Svc
participant "Commitments.Api" as Api
database "SQL Server" as DB

User -> Comp: tile mounts
Comp -> Ctrl: ngOnInit
par
    Ctrl -> Svc: getCurrent(goalId)
    Svc -> Api: GET /current
    Api -> DB: count today
    DB --> Api: count, target
    Api --> Svc: GoalProgressDto
    Svc --> Ctrl: {count, target, asOf}
also
    Ctrl -> Svc: getLast14(goalId)
    Svc -> Api: GET /last14
    Api -> DB: group by date
    DB --> Api: 14 rows
    Api --> Svc: Last14DayDto[]
    Svc --> Ctrl: 14 points
end
Ctrl -> Comp: signals settled
Comp --> User: renders metric, delta, bars

@enduml
