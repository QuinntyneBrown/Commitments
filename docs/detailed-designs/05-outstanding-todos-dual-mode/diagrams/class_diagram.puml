@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Outstanding Todos Tile - Domain Model

class OutstandingTodosTileComponent {
  +tileMetadata: TileMetadata
  -context: TileContext
  -controller: OutstandingTodosController
}

class OutstandingTodosController {
  +snapshot: Signal<OutstandingTodosDto|null>
  +mode: Signal<DashboardMode>
  +count: Signal<number>
  +deltaLabel: Signal<string|null>
  +deltaTone: Signal<'success'|'warn'|'neutral'>
  +load(mode, asOf): void
}

class OutstandingTodosService {
  +get(mode, asOf): Observable<OutstandingTodosDto>
}

class OutstandingTodosDto {
  +mode: 'live'|'review'
  +asOf: string
  +count: number
  +todayCount?: number
}

class GetOutstandingToDoCountQuery {
  +AsOf: DateTimeOffset?
  +IncludeToday: bool
}

class GetOutstandingToDoCountHandler {
  +Handle(q): OutstandingTodosDto
}

OutstandingTodosTileComponent o-- OutstandingTodosController
OutstandingTodosController --> OutstandingTodosService
OutstandingTodosService ..> OutstandingTodosDto
GetOutstandingToDoCountHandler ..> GetOutstandingToDoCountQuery

@enduml
