@startuml sequence_activity_invalidation
!theme plain
skinparam sequenceMessageAlign center

title Activity Recorded -> 5 tiles refresh

actor B as "Editor"
actor A as "Owner"
participant "SaveActivity\nHandler" as SH
participant "InMemoryEventBus" as BUS
participant "Invalidation\nNotifier" as NOT
participant "IRealtime\nPublisher" as PUB
participant "/hub" as HUB
participant "TileInvalidation\nService" as SVC
participant "5 tile controllers" as TC

B -> SH: SaveActivity
SH -> BUS: ActivityRecordedEvent
BUS -> NOT: HandleAsync
NOT -> PUB: dashboardTileData\nInvalidated\n{datasets:5,reason:'activityChanged'}
PUB -> HUB: SendAsync envelope
HUB -> A: WSS frame
A -> SVC: payload arrives
SVC -> TC: 5 routed Observables
TC -> TC: each calls _refresh() / requestRefresh()
TC --> A: re-rendered tiles

@enduml
