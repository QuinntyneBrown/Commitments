@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Tile Invalidation Bus - Containers

System_Boundary(client, "Browser") {
    Container(srv, "TileInvalidationService", "Angular root", "invalidations$(dataset)")
    Container(tiles, "Aggregate tiles", "Angular standalone", "5 tiles + Trend")
}

System_Boundary(server, "Commitments.Api") {
    Container(handlers, "Command handlers", "MediatR", "publish events")
    Container(bus, "InMemoryEventBus", "Singleton", "ActivityRecorded,\nCommitmentChanged,\nFrequencyChanged,\nToDoChanged")
    Container(notif, "DashboardTile\nInvalidationNotifier", "IHostedService", "maps events to one msg")
    Container(pub, "IRealtimePublisher", "Singleton", "envelope")
    Container(hub, "/hub", "SignalR", "profile group")
}

Rel(handlers, bus, "PublishAsync")
Rel(bus, notif, "delivers")
Rel(notif, pub, "PublishToProfileAsync")
Rel(pub, hub, "SendAsync")
Rel(hub, srv, "WSS frame")
Rel(srv, tiles, "Observable<payload>")

@enduml
