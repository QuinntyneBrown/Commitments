@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Plugin Contracts - Public Surface

class TileManifest {
    +id: string
    +title: string
    +supportedModes: DashboardMode[]
    +component: Type | Map<DashboardMode, Type>
    +defaultPositions?: Map<DashboardMode, GridsterItem>
    +icon?: string
}

interface TileContext {
    +mode: Signal<DashboardMode>
    +selectedReviewDate: Signal<string | null>
    +refresh$: Observable<void>
    +requestRefresh(): void
}

class TileRegistryService {
    +register(manifest): void
    +tilesForMode(mode): TileManifest[]
    +componentFor(id, mode): Type
    +defaultsFor(mode): GridsterItem[]
}

class TileHostDirective {
    +tileId: string
}

TileRegistryService --> "*" TileManifest
TileHostDirective --> TileRegistryService
TileHostDirective ..> TileContext : 'provides'

@enduml
