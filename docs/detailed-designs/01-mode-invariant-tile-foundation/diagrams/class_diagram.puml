@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Mode-Invariant Tile Foundation - Domain Model

interface TileContext {
  +tileId: string
  +instanceId: string
  +mode: Signal<'live'|'review'>
  +selectedReviewDate: Signal<string|null>
  +refresh$: Observable<void>
  +isEditMode: Signal<boolean>
  +requestRefresh(): void
}

class TileMetadata {
  +tileId: string
  +displayName: string
  +defaultSize: TileSize
  +supportedModes?: ['live','review']
}

class TileDescriptor {
  +componentType: Type<unknown>
}

class TileRegistryService {
  -byId: Map<string, TileDescriptor>
  +registerTile(d: TileDescriptor): void
  +tilesForMode(mode): TileDescriptor[]
}

class MisconfiguredTileError {
  +tileId: string
  +message: string
}

class BindTileModeOptions {
  +context: TileContext|null
  +invalidations$?: Observable<unknown>
  +load(mode, asOf): void
}

TileMetadata <|-- TileDescriptor
TileRegistryService o-- TileDescriptor
TileRegistryService ..> MisconfiguredTileError : throws
TileRegistryService ..> TileMetadata : validates supportedModes
BindTileModeOptions ..> TileContext : reads

@enduml
