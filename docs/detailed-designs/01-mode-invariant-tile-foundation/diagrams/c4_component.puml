@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Mode-Invariant Tile Foundation - Components (Frontend)

Container_Boundary(framework, "dashboard-framework") {
  Component(registry, "TileRegistryService", "Angular service", "Registers descriptors; enforces mode invariant")
  Component(ctx, "TileContext", "DI token", "mode, selectedReviewDate, refresh$, isEditMode")
  Component(bind, "bindTileMode()", "Function", "Standard load + effect plumbing for tiles")
}

Container_Boundary(plugin, "commitments-dashboard-plugin") {
  Component(tile, "PluginTile (e.g. DailyResults)", "Angular component", "Inputs: tileId metadata; reads TileContext")
  Component(ctrl, "TileController", "Injectable", "Owns signal model; calls service.fetch(asOf)")
  Component(svc, "TileDataService", "HttpClient wrapper", "GET .../resource?asOf=...")
}

Container_Boundary(ui, "commitments-ui") {
  Component(shell, "TileShellComponent", "Angular component", "Header, eyebrow, status, body slot")
  Component(pill, "StatusPillComponent", "Angular component", "LIVE (pulse) | REVIEW")
}

Rel(tile, ctx, "inject(TILE_CONTEXT, optional)")
Rel(tile, bind, "bindTileMode({...})")
Rel(bind, ctrl, "load(mode, asOf)")
Rel(ctrl, svc, "Calls")
Rel(tile, shell, "Renders")
Rel(shell, pill, "Embeds")
Rel(registry, tile, "Resolves componentType")

@enduml
