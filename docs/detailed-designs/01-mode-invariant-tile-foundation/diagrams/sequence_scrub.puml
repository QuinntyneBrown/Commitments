@startuml sequence_scrub
!theme plain
skinparam sequenceMessageAlign center

title Slider scrub - debounced fetch + cacheable response

actor User
participant "Scrubber" as Sc
participant "TileContext" as Ctx
participant "PluginTile" as Tile
participant "TileController" as Ctrl
participant "API" as API
participant "BrowserCache" as Cache

User -> Sc: Drag slider (50 events / 200ms)
loop debounce 100ms
  Sc -> Ctx: selectedReviewDate.set(date)
end
Ctx -> Tile: signal change (latest date only)
Tile -> Ctrl: load('review', date)
Ctrl -> Cache: GET /resource?asOf=<date>
alt Hit (asOf < UtcNow - 1m)
  Cache --> Ctrl: 200 (cached)
else Miss
  Ctrl -> API: GET /resource?asOf=<date>
  API -> API: clamp asOf, query
  API --> Ctrl: 200 + Cache-Control: public, max-age=300
  Ctrl -> Cache: store
end
Ctrl --> Tile: signal update
Tile --> User: Body shows historical aggregate

@enduml
