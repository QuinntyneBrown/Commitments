@startuml c4_context
!theme plain
!include <C4/C4_Context>

title Mode-Invariant Tile Foundation - System Context

Person(user, "User", "Authenticated dashboard user; toggles Live/Review")

System_Boundary(sys, "Commitments App") {
  System(spa, "Angular SPA", "Renders dashboard tiles in Live or Review mode")
  System(api, "Commitments API", "ASP.NET Core modular monolith")
}

System_Ext(db, "SQL Server", "Per-module schemas; soft-delete; profile-scoped")
System_Ext(signalr, "SignalR Hub", "profile:{profileId} groups; tile-data invalidations")

Rel(user, spa, "Uses dashboard")
Rel(spa, api, "Snapshot reads (asOf)", "HTTPS/JSON")
Rel(spa, signalr, "Receives invalidations", "WebSocket")
Rel(api, db, "Reads aggregates", "SQL")
Rel(api, signalr, "Publishes invalidations", "in-process")

@enduml
