@startuml sequence_edit
!theme plain
skinparam sequenceMessageAlign center

title Edit a card

actor User
participant "CardsPage" as Page
participant "EditCardDialog" as Dlg
participant "CardService" as Svc
participant "CardController" as Ctrl
participant "SaveCardHandler" as H
database "Dashboard DB" as DB

User -> Page: Click edit cell
Page -> Dlg: open(cardId)
Dlg -> Svc: getById
Svc -> Ctrl: GET /card/{id}
Ctrl --> Svc: 200 { card }
Svc --> Dlg: dto
User -> Dlg: Edit + Save
Dlg -> Svc: save({ card })
Svc -> Ctrl: POST /card
Ctrl -> H: Send(request)
H -> DB: UPDATE Card
DB --> H: ok
H --> Ctrl: { cardId }
Ctrl --> Svc: 200
Svc --> Dlg: id
Dlg --> Page: close(updatedDto)
Page -> Page: addOrUpdate row
Page --> User: Render row

@enduml
