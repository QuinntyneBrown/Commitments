@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title commitments-ui - Public Surface

class Tokens <<const>> {
    +BG_APP: string
    +SURFACE_TILE: string
    +ACCENT_LIVE: string
    +ACCENT_REVIEW: string
    +ACCENT_CHART: string
    +ACCENT_SUCCESS: string
    +TEXT_PRIMARY: string
    +TEXT_SECONDARY: string
    +TEXT_MUTED: string
}

class ModeToggleComponent {
    +mode: 'live' | 'review'
    +disabled?: boolean
    +modeChange: EventEmitter
}

class StatusPillComponent {
    +variant: 'live' | 'review' | 'neutral'
    +pulse?: boolean
    +label: string
}

class IconButtonComponent {
    +icon: string
    +ariaLabel: string
    +disabled?: boolean
    +pressed?: boolean
    +pressedChange: EventEmitter
}

class TileShellComponent {
    +variant: 'metric' | 'review' | 'chart'
    +title: string
    +subtitle?: string
}

class MetricHeaderComponent {
    +value: string
    +caption?: string
    +accent?: 'live' | 'review' | 'chart'
}

class DeltaBadgeComponent {
    +delta: number
    +format?: 'percent' | 'count'
    +caption?: string
}

ModeToggleComponent ..> Tokens
StatusPillComponent ..> Tokens
IconButtonComponent ..> Tokens
TileShellComponent ..> Tokens
MetricHeaderComponent ..> Tokens
DeltaBadgeComponent ..> Tokens

@enduml
