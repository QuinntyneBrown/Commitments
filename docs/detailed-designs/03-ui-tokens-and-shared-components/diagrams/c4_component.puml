@startuml c4_component
!theme plain
!include <C4/C4_Component>

title commitments-ui - Component Diagram

Container_Boundary(ui, "commitments-ui") {
    Component(tokens, "tokens", "SCSS + TS", "Color, spacing, radius constants")
    Component(modeToggle, "ModeToggleComponent", "Angular standalone", "Live/Review segmented toggle")
    Component(statusPill, "StatusPillComponent", "Angular standalone", "Live/Review/neutral pill")
    Component(iconBtn, "IconButtonComponent", "Angular standalone", "Square icon control")
    Component(tileShell, "TileShellComponent", "Angular standalone", "Metric/Review/Chart tile chrome")
    Component(metricHdr, "MetricHeaderComponent", "Angular standalone", "Large value + caption")
    Component(deltaBadge, "DeltaBadgeComponent", "Angular standalone", "Signed delta vs reference")
}

Rel(modeToggle, tokens, "Uses")
Rel(statusPill, tokens, "Uses")
Rel(iconBtn, tokens, "Uses")
Rel(tileShell, tokens, "Uses")
Rel(metricHdr, tokens, "Uses")
Rel(deltaBadge, tokens, "Uses")

@enduml
