@startuml c4_container
!theme plain
!include <C4/C4_Container>

title UI Tokens And Shared Components - Container Diagram

Person(dev, "Frontend Developer")

System_Boundary(spa, "Commitments SPA") {
    Container(app, "commitments-app", "Angular shell", "Routes and providers")
    Container(fw, "dashboard-framework", "Angular library", "Mode + layout state")
    Container(plugin, "commitments-dashboard-plugin", "Angular library", "Tiles and adapters")
    Container(ui, "commitments-ui", "Angular library", "Tokens + presentational components")
}

Rel(dev, ui, "Imports")
Rel(app, ui, "Uses tokens + primitives")
Rel(fw, ui, "Uses tile-shell, mode-toggle, icon-button")
Rel(plugin, ui, "Uses tile-shell, metric-header, delta-badge, status-pill")

@enduml
