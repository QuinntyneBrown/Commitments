@startuml sequence_settings
!theme plain
skinparam sequenceMessageAlign center

title Settings page - boundary assertion

actor Spec
participant Po as "SettingsPagePo"
participant Browser
participant Page as "SettingsPageComponent"
participant Svc as "ProfileService\n(peer)"
participant Mock as "MockDashboardBackendService"
participant Bridge as "WindowFeatureBridgeService"

Spec -> Po: pom.goto()
Po -> Browser: page.goto('/settings')
Browser -> Page: ngOnInit()
Page -> Svc: current()
Svc -> Mock: get('api/v1.0/profiles/current')
Mock -> Bridge: recordBackend(get)
Mock --> Svc: {profile}
Svc --> Page: render

Spec -> Po: pom.displayName.textContent()
Po --> Spec: 'Alice'
Spec -> Po: pom.backendCalls()
Po --> Spec: [{method:'get', path:'api/v1.0/profiles/current'}]
Spec -> Spec: expect single get call

@enduml
