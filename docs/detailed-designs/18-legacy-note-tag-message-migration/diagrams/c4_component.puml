@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Note/Tag Realtime - Components

Container_Boundary(api, "API host") {
    Component(saveN, "SaveNoteHandler", "MediatR", "publishes NoteSavedEvent")
    Component(remN, "RemoveNoteHandler", "MediatR", "publishes NoteRemovedEvent")
    Component(saveT, "SaveTagHandler", "MediatR", "publishes TagSavedEvent")
    Component(remT, "RemoveTagHandler", "MediatR", "publishes TagRemovedEvent")
    Component(notif, "NoteTagRealtimeNotifier", "IHostedService", "4 branches")
    Component(pub, "IRealtimePublisher", "abstraction", "envelope")
}

Container_Boundary(spa, "SPA core") {
    Component(client, "HubClient.on<T>", "Angular service", "")
    Component(store, "Store getters", "Angular root", "savedNotes$, ...")
    Component(notesL, "notes-list", "Angular standalone", "")
    Component(tagsL, "tags-list", "Angular standalone", "")
}

Rel(saveN, notif, "via bus")
Rel(remN, notif, "via bus")
Rel(saveT, notif, "via bus")
Rel(remT, notif, "via bus")
Rel(notif, pub, "PublishToProfileAsync")
Rel(pub, client, "WSS")
Rel(client, store, "on<T>")
Rel(store, notesL, "savedNotes$, removedNotes$")
Rel(store, tagsL, "savedTags$, removedTags$")

@enduml
