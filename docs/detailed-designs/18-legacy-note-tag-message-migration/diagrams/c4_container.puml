@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Note/Tag Realtime - Containers

System_Boundary(client, "Browser") {
    Container(store, "Store", "Angular root", "savedNotes$, removedNotes$,\nsavedTags$, removedTags$")
    Container(notes, "Notes / Tags components", "Angular standalone", "subscribe Store getters")
}

System_Boundary(server, "Commitments.Api") {
    Container(handlers, "Note + Tag handlers", "MediatR", "Save / Remove")
    Container(bus, "InMemoryEventBus", "Singleton", "Note/Tag events")
    Container(notif, "NoteTagRealtimeNotifier", "IHostedService", "4 subscriptions")
    Container(pub, "IRealtimePublisher", "Singleton", "envelope")
    Container(hub, "/hub", "SignalR", "profile group")
}

Rel(handlers, bus, "Publish")
Rel(bus, notif, "Deliver")
Rel(notif, pub, "PublishToProfileAsync")
Rel(pub, hub, "SendAsync envelope")
Rel(hub, store, "WSS frame")
Rel(store, notes, "Observable")

@enduml
