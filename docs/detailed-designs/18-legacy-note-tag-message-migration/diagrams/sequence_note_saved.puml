@startuml sequence_note_saved
!theme plain
skinparam sequenceMessageAlign center

title Note Saved Across Tabs

actor B as "Editor"
actor A as "Owner"
participant "SaveNoteHandler" as SH
participant "InMemoryEventBus" as BUS
participant "NoteTag\nNotifier" as NOT
participant "/hub" as HUB
participant "Store.savedNotes$" as ST
participant "notes-list" as NL

B -> SH: POST /note
SH -> BUS: NoteSavedEvent
BUS -> NOT: HandleAsync
NOT -> HUB: noteSaved envelope\n{noteId,title,kind}
HUB -> A: WSS frame
A -> ST: on<NoteSavedPayload>('noteSaved')\n.map -> {note}
ST -> NL: prepend / update row
NL --> A: list updates

@enduml
