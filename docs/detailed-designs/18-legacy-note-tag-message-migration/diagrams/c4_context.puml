@startuml c4_context
!theme plain
!include <C4/C4_Context>

title Note/Tag Realtime - Context

Person(owner, "Profile Owner", "Sees notes/tags update across tabs")
Person(other, "Same-profile editor", "Edits note or tag")
System(spa, "Commitments SPA", "Notes / Tags pages, Store")
System(api, "Commitments API", "Note + Tag command handlers")

Rel(other, api, "Save / Remove")
Rel(api, spa, "noteSaved, noteRemoved,\ntagSaved, tagRemoved", "WSS envelope")
Rel(spa, owner, "List updates")

@enduml
