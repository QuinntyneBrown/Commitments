@startuml sequence_tag_removed
!theme plain
skinparam sequenceMessageAlign center

title Tag Removed Across Tabs

actor B as "Editor"
actor A as "Owner"
participant "RemoveTagHandler" as RH
participant "InMemoryEventBus" as BUS
participant "NoteTag\nNotifier" as NOT
participant "/hub" as HUB
participant "Store.removedTags$" as ST
participant "tags-list" as TL

B -> RH: DELETE /tag/{id}
RH -> BUS: TagRemovedEvent
BUS -> NOT: HandleAsync
NOT -> HUB: tagRemoved envelope\n{tagId}
HUB -> A: WSS frame
A -> ST: on<TagRemovedPayload>('tagRemoved')
ST -> TL: handleTagRemoved({tagId})
TL --> A: chip disappears

@enduml
