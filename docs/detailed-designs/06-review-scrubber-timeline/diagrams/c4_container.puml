@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Review Scrubber - Container Diagram

Person(user, "Profile Owner")

System_Boundary(spa, "Commitments SPA") {
    Container(fw, "dashboard-framework", "Angular library", "Hosts ReviewScrubberComponent + DashboardModeService")
    Container(ui, "commitments-ui", "Angular library", "IconButton, StatusPill, tokens")
    Container(plugin, "commitments-dashboard-plugin", "Angular library", "Review tiles read selectedReviewDate")
}

Rel(user, fw, "Interact")
Rel(fw, ui, "Uses primitives")
Rel(plugin, fw, "Reads selected date via TileContext")

@enduml
