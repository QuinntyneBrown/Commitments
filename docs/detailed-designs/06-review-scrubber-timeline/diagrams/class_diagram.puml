@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Review Scrubber - Domain Model

class ReviewScrubberComponent {
    +windowDays: number
}

class ReviewScrubberController {
    +windowStart: Signal<string>
    +windowEnd: Signal<string>
    +selectedDate: Signal<string>
    +selectedIndex: Signal<number>
    +tickLabels: Signal<string[]>
    +isPlaying: Signal<boolean>
    +prev(): void
    +next(): void
    +playToggle(): void
    +jumpToToday(): void
    +scrubTo(index): void
}

class ReviewScrubberHelpers <<pure>> {
    +isoDateAtIndex(start, index): string
    +indexOfDate(start, date): number
    +clampIndex(i, max): number
    +tickLabels(start, count, slot): string[]
}

class ReviewWindow <<value>> {
    +start: string
    +end: string
    +windowDays: number
}

ReviewScrubberComponent --> ReviewScrubberController
ReviewScrubberController ..> ReviewScrubberHelpers
ReviewScrubberController --> ReviewWindow

@enduml
