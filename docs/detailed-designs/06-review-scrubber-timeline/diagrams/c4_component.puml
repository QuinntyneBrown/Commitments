@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Review Scrubber - Component Diagram

Container_Boundary(fw, "dashboard-framework") {
    Component(comp, "ReviewScrubberComponent", "Angular standalone", "Track + tick labels + buttons")
    Component(ctrl, "ReviewScrubberController", "Angular @Injectable", "Window math, play interval, debounce")
    Component(helpers, "review-scrubber.helpers.ts", "Pure TS", "Index <-> date, tick labels")
    Component(mode, "DashboardModeService", "From Feature 04", "selectedReviewDate signal")
}

Rel(comp, ctrl, "Calls prev / next / play / scrub")
Rel(ctrl, helpers, "Uses pure helpers")
Rel(ctrl, mode, "setSelectedReviewDate(...)")
Rel(comp, mode, "Reads current date for highlight")

@enduml
