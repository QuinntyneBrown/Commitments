@startuml sequence_play
!theme plain
skinparam sequenceMessageAlign center

title Play / Auto-Scrub

actor User
participant ReviewScrubberController as Ctrl
participant DashboardModeService as Mode

User -> Ctrl: playToggle()
Ctrl -> Ctrl: isPlaying = true
loop every 1s while isPlaying and selectedIndex < windowDays-1
    Ctrl -> Ctrl: next()
    Ctrl -> Mode: setSelectedReviewDate(nextDate)
end
Ctrl -> Ctrl: auto-pause at end\nisPlaying = false

@enduml
