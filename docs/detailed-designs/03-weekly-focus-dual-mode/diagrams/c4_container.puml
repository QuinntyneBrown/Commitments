@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Weekly Focus Tile - Containers

Person(user, "User", "Dashboard user")

System_Boundary(spa, "Angular SPA") {
  Container(plugin, "commitments-dashboard-plugin", "Angular lib", "WeeklyFocusTileComponent + Controller")
  Container(framework, "dashboard-framework", "Angular lib", "TileContext, bindTileMode")
  Container(invs, "TileInvalidationService", "Angular service", "invalidations$('weeklyFocus')")
}

System_Boundary(api, "Commitments.Api Host") {
  Container(commit, "Commitments Module", ".NET 9", "GetWeeklyFocusHandler")
  Container(realtime, "Realtime", "ASP.NET", "DashboardTileInvalidationNotifier")
}

ContainerDb(db, "SQL Server", "RDBMS", "Activities per profile")

Rel(user, plugin, "Sees focus list + LIVE/REVIEW pill")
Rel(plugin, framework, "TILE_CONTEXT, bindTileMode")
Rel(plugin, invs, "Subscribes")
Rel(plugin, commit, "GET /weekly-focus?asOf", "JSON")
Rel(commit, db, "Top-N behaviours within week", "SQL")
Rel(realtime, invs, "weeklyFocus", "WebSocket")

@enduml
