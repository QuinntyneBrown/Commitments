@startuml c4_context
!theme plain
!include <C4/C4_Context>

title Weekly Focus Tile - System Context

Person(user, "User", "Views weekly focus areas")

System_Boundary(sys, "Commitments App") {
  System(spa, "Angular SPA", "Hosts WeeklyFocusTileComponent")
  System(api, "Commitments API", "GetWeeklyFocus query (asOf-aware)")
}

System_Ext(db, "SQL Server", "Activities + Behaviours per profile")
System_Ext(signalr, "SignalR Hub", "weeklyFocus invalidations")

Rel(user, spa, "Mode toggle, scrub")
Rel(spa, api, "GET /weekly-focus?asOf", "JSON")
Rel(spa, signalr, "Listens for weeklyFocus")
Rel(api, db, "Top-N behaviours by activity")
Rel(api, signalr, "Publishes invalidations")

@enduml
