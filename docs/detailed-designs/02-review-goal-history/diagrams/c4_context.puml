@startuml c4_context
!theme plain
!include <C4/C4_Context>

title Review Goal History - System Context

Person(owner, "Profile Owner", "Wants to look back at goal progress")

System_Boundary(commitments, "Commitments Platform") {
  System(spa, "Commitments SPA", "Angular dashboard with the Review Goal tile")
  System(api, "Commitments API", "Computes historical counts on demand")
}

Rel(owner, spa, "Picks a window, scrubs the slider", "HTTPS")
Rel(spa, api, "GET goal progress at asOf", "HTTPS")

@enduml
