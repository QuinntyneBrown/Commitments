@startuml sequence_reconnect
!theme plain
skinparam sequenceMessageAlign center

title Network drop and recovery

actor Owner
participant "HubClient" as HC
participant "HubRetryPolicy" as POL
participant "Browser network" as NET
participant "/hub" as HUB
participant "CommitmentsHub" as SHUB
participant "Tiles" as TC

Owner -> NET: lose connection
NET -> HC: WebSocket close
HC -> HC: state = Reconnecting
loop until success or 5min
  HC -> POL: nextRetryDelayInMilliseconds(ctx)
  POL --> HC: 0 / 2s / 5s / 10s / 30s
  HC -> NET: try connect
end
NET -> HUB: WSS upgrade
HUB -> SHUB: OnReconnectedAsync
SHUB -> SHUB: AddToGroup('profile:{id}')
HC -> HC: state = Connected
HC -> TC: hubResumed envelope
TC -> TC: refetch / requestRefresh

@enduml
