@startuml sequence_profile_switch
!theme plain
skinparam sequenceMessageAlign center

title Profile switch rebinds the hub

actor User
participant "Profiles page" as PP
participant "LocalStorage\nService" as LS
participant "ProfileSwitch\nListener" as LIS
participant "HubClient" as HC
participant "CommitmentsHub" as SHUB
participant "Tiles" as TC

User -> PP: pick new profile
PP -> LS: put(currentProfileIdKey, newId)
LS -> LIS: changes$ emits newId
LIS -> HC: restartFor(newId)
HC -> HC: stop existing connection\nreset idempotence cache
HC -> SHUB: new connect with profileId=newId
SHUB -> SHUB: AddToGroup('profile:{newId}')
HC -> TC: hubResumed envelope
TC -> TC: refetch (new profile data)

@enduml
