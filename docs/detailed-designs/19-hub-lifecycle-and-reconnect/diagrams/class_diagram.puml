@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Hub Lifecycle - Classes

class HubClient {
    -connection: HubConnection
    -idempotence: MessageIdempotenceCache
    +messages$: Subject<any>
    +connect(): Promise<void>
    +disconnect(): void
    +restartFor(profileId): Promise<void>
    +on<T>(event): Observable<T>
}

class MessageIdempotenceCache {
    -seen: Set<string>
    -order: string[]
    -capacity: int
    +seen(messageId): boolean
}

class "HubRetryPolicy : IRetryPolicy" as POL {
    +nextRetryDelayInMilliseconds(ctx): number?
}

class ProfileSwitchListener {
    -storage: LocalStorageService
    -hub: HubClient
    +start(): void
}

class CommitmentsHub <<Hub>> {
    +OnConnectedAsync(): Task
    +OnReconnectedAsync(): Task
}

HubClient --> MessageIdempotenceCache
HubClient --> POL
ProfileSwitchListener --> HubClient
HubClient ..> CommitmentsHub : WSS

@enduml
