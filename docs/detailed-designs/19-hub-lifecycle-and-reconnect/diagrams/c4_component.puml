@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Hub Lifecycle - Components

Container_Boundary(spa, "Commitments SPA") {
    Component(client, "HubClient", "Angular root", "connect / disconnect / restartFor")
    Component(retry, "HubRetryPolicy", "TS module", "IRetryPolicy")
    Component(idem, "MessageIdempotenceCache", "TS class", "seen(messageId)")
    Component(guard, "hubClientGuard", "CanActivateFn", "auth gate")
    Component(switch, "ProfileSwitchListener", "Angular root", "LS subscription")
    Component(invs, "TileInvalidationService", "Angular root", "fans out hubResumed")
    Component(tiles, "Tile controllers", "Angular service", "refetch on hubResumed")
}

Container_Boundary(api, "Commitments.Api") {
    Component(hub, "CommitmentsHub", "Hub", "OnReconnectedAsync rejoins group")
}

Rel(guard, client, "connect")
Rel(switch, client, "restartFor")
Rel(client, retry, "withAutomaticReconnect")
Rel(client, idem, "filter dupes")
Rel(client, hub, "WSS")
Rel(client, invs, "hubResumed")
Rel(invs, tiles, "refetch")

@enduml
