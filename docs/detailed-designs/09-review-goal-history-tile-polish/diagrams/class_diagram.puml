@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Review Tile - Domain Model

class GoalProgressDto {
    +goalId: int
    +target: int
    +count: int
    +asOf: DateTimeOffset
}

class ReviewGoalHistoryController {
    +selectedDate: Signal<string>
    +historical: Signal<GoalProgressDto | null>
    +today: Signal<GoalProgressDto | null>
    +delta: Signal<number>
    +selectedDateLabel: Signal<string>
}

class ReviewGoalHistoryTileComponent {
    +goalId: number
}

ReviewGoalHistoryTileComponent --> ReviewGoalHistoryController
ReviewGoalHistoryController ..> GoalProgressDto

@enduml
