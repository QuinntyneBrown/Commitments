    +mode: 'live'
    +asOf: ISO string
    +completed: 7
    +total: 12
}

class "page.route(pattern, fulfill)" as PWROUTE <<Playwright>> {
}

class "Plugin tile services\n(DailyResultsService, ...)" as PLUGSVC <<plugin (unchanged)>> {
    +HttpClient.get('api/v1.0/...')
}

