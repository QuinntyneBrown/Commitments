@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Edit Note - Component Diagram

Person(user, "Signed-in User")

Container_Boundary(spa, "commitments-app") {
    Component(page, "EditNotePage", "Angular standalone", "Hosts editor")
    Component(quill, "quill-text-editor", "Angular wrapper", "QuillJS")
    Component(resolver, "note-resolver.service", "Angular Resolver", "Pre-fetch note by slug")
    Component(svc, "NotesService", "Angular service", "REST")
}

Container_Boundary(api, "Commitments.Api / Commitments module") {
    Component(ctrl, "NoteController", "ASP.NET Core", "GET slug, POST")
    Component(saveH, "SaveNoteHandler", "MediatR + FV", "Sanitise + slug + event")
    Component(slugH, "GetNoteBySlugHandler", "MediatR", "Lookup")
    ComponentDb(db, "Commitments DB", "SQL Server", "Notes")
}

Rel(user, page, "Navigate /edit-note/:slug")
Rel(page, resolver, "Resolves note")
Rel(resolver, svc, "getBySlug")
Rel(svc, ctrl, "GET / POST")
Rel(page, quill, "Hosts and binds")
Rel(page, svc, "save()")
Rel(ctrl, slugH, "Send")
Rel(ctrl, saveH, "Send")
Rel(saveH, db, "INSERT/UPDATE sanitised body")
Rel(slugH, db, "SELECT WHERE Slug=...")

@enduml
