@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Relations Tile - Containers

Person(user, "User")

System_Boundary(spa, "Angular SPA") {
  Container(plugin, "commitments-dashboard-plugin", "Angular lib", "RelationsTileComponent + Controller")
  Container(framework, "dashboard-framework", "Angular lib", "TileContext, bindTileMode")
  Container(invs, "TileInvalidationService", "Angular service", "invalidations$('relations')")
}

System_Boundary(api, "Commitments.Api Host") {
  Container(commit, "Commitments Module", ".NET 9", "GetRelationsSummaryHandler")
  Container(realtime, "Realtime", "ASP.NET", "DashboardTileInvalidationNotifier")
}

ContainerDb(db, "SQL Server", "RDBMS", "Commitments + Behaviours + BehaviourTypes")

Rel(user, plugin, "Sees distribution + LIVE/REVIEW pill")
Rel(plugin, framework, "TILE_CONTEXT, bindTileMode")
Rel(plugin, invs, "Subscribes")
Rel(plugin, commit, "GET /relations/summary", "JSON")
Rel(commit, db, "GROUP BY BehaviourType, percentages", "SQL")
Rel(realtime, invs, "relations", "WebSocket")

@enduml
