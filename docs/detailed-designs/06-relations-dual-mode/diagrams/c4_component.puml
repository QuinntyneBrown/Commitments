@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Relations Tile - Components

Container_Boundary(plugin, "commitments-dashboard-plugin") {
  Component(tile, "RelationsTileComponent", "Angular component", "Shell + pill + 3-row grid")
  Component(ctrl, "RelationsController", "Injectable", "Signals: snapshot/relations/isEmpty")
  Component(svc, "RelationsSummaryService", "Angular service", "GET /relations/summary")
}

Container_Boundary(ui, "commitments-ui") {
  Component(shell, "TileShellComponent", "Angular component", "Header/eyebrow/status/body")
  Component(pill, "StatusPillComponent", "Angular component", "LIVE | REVIEW")
}

Container_Boundary(framework, "dashboard-framework") {
  Component(ctx, "TILE_CONTEXT", "DI token", "mode, selectedReviewDate")
  Component(bind, "bindTileMode()", "Function", "load + effect + invalidations")
}

Component(invs, "TileInvalidationService", "Angular service", "invalidations$('relations')")

Rel(tile, ctx, "inject(optional)")
Rel(tile, bind, "bindTileMode")
Rel(bind, ctrl, "load(mode, asOf)")
Rel(ctrl, svc, "Calls")
Rel(tile, shell, "Renders")
Rel(shell, pill, "Embeds")
Rel(bind, invs, "Subscribes")

@enduml
