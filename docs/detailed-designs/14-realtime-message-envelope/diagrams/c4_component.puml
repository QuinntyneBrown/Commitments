@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Realtime Envelope - Components

Container_Boundary(api, "Commitments.Api host") {
    Component(handler, "Caller (e.g. controller / event handler)", "C#", "Builds payload")
    Component(pub, "IRealtimePublisher", "abstraction in Shared", "PublishToProfileAsync")
    Component(impl, "SignalRRealtimePublisher", "implementation in Api", "Wraps + sends")
    Component(env, "RealtimeMessage<TPayload>", "record in Shared", "Envelope")
    Component(ctx, "IHubContext<CommitmentsHub>", "ASP.NET Core SignalR", "Group send")
}

Container_Boundary(spa, "Commitments SPA") {
    Component(client, "HubClient", "Angular service", "messages$ stream")
    Component(on, "HubClient.on<T>(event)", "Angular service method", "filter + map")
    Component(tile, "Tile controller", "Angular service", "subscribes")
}

Rel(handler, pub, "calls")
Rel(pub, impl, "DI")
Rel(impl, env, "constructs")
Rel(impl, ctx, "SendAsync('message', envelope)")
Rel(client, on, "exposes")
Rel(on, tile, "Observable<TPayload>")

@enduml
