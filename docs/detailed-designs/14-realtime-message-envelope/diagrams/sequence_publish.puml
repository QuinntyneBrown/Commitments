@startuml sequence_publish
!theme plain
skinparam sequenceMessageAlign center

title Backend publish path (envelope)

participant "Caller\n(Controller / Handler)" as CT
participant "IRealtimePublisher" as PUB
participant "SignalR\nIHubContext" as CTX
participant "WebSocket\n(profile group)" as WS

CT -> PUB: PublishToProfileAsync(\n  profileId,\n  event = 'hubPing',\n  payload = {text:'hello'})
PUB -> PUB: messageId = NewGuid()\noccurredAt = UtcNow\nenvelope = RealtimeMessage<...>
PUB -> CTX: Clients.Group('profile:{id}')\n.SendAsync('message', envelope)
CTX -> WS: frame
WS --> CT: (fire and forget)

@enduml
