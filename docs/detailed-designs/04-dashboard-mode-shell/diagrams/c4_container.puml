@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Dashboard Mode Shell - Container Diagram

Person(user, "Profile Owner")

System_Boundary(spa, "Commitments SPA") {
    Container(app, "commitments-app", "Angular shell", "Routes, providers")
    Container(fw, "dashboard-framework", "Angular library", "Mode + layout + Gridster host")
    Container(ui, "commitments-ui", "Angular library", "ModeToggle, IconButton")
    ContainerDb(ls, "Browser localStorage", "Web storage", "Persists mode + selected date")
}

Rel(user, app, "Loads", "HTTPS")
Rel(app, fw, "provideDashboardFramework()")
Rel(fw, ui, "Uses cui-mode-toggle")
Rel(fw, ls, "Read / write", "JSON strings")

@enduml
