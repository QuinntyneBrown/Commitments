@startuml sequence_drag_persist
!theme plain
skinparam sequenceMessageAlign center

title Drag and Persist (Per-Mode)

actor User
participant Gridster
participant DashboardShellComponent as Shell
participant DashboardLayoutService as L
database localStorage as LS

User -> Gridster: drag tile
Gridster -> Shell: itemChangeCallback(snapshot)
Shell -> L: replaceLayout(currentMode, snapshot)
L -> L: update matching signal
alt mode === 'live'
    L -> LS: setItem('commitments.layout.live', JSON)
else mode === 'review'
    L -> LS: setItem('commitments.layout.review', JSON)
end

@enduml
