@startuml sequence_initial_render
!theme plain
skinparam sequenceMessageAlign center

title Initial Render - Live

participant Bootstrap as B
participant DashboardLayoutService as L
database localStorage as LS
participant "Tile Registry" as R
participant DashboardShellComponent as Shell
participant Gridster

B -> L: <<construct>>
L -> LS: getItem('commitments.layout.live')
LS --> L: JSON or null
alt missing
    L -> R: defaults for mode 'live'
    R --> L: GridsterItem[]
end
L -> LS: getItem('commitments.layout.review')
B -> Shell: render
Shell -> L: currentLayout()
L --> Shell: liveLayout signal value
Shell -> Gridster: items=liveLayout
Gridster -> Shell: render tiles

@enduml
