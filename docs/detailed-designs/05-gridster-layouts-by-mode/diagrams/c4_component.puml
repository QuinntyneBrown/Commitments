@startuml c4_component
!theme plain
!include <C4/C4_Component>

title dashboard-framework Layout - Component Diagram

Container_Boundary(fw, "dashboard-framework") {
    Component(shell, "DashboardShellComponent", "Angular standalone", "Hosts <gridster> bound to currentLayout")
    Component(layout, "DashboardLayoutService", "Angular @Injectable", "Two signals: liveLayout, reviewLayout")
    Component(mode, "DashboardModeService", "From Feature 04", "Provides current mode")
    Component(reg, "Tile Registry", "From Feature 10", "Default positions per mode")
    ComponentDb(ls, "localStorage", "Web Storage")
}

Rel(shell, layout, "Reads currentLayout()")
Rel(shell, mode, "Reads mode()")
Rel(layout, mode, "Switches signal by mode")
Rel(layout, reg, "Seeds defaults from registry")
Rel(layout, ls, "Persists per-mode JSON")

@enduml
