@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Chart Tile - Container Diagram

Person(user, "Profile Owner")

System_Boundary(spa, "Commitments SPA") {
    Container(plugin, "commitments-dashboard-plugin", "Angular library", "Chart tile + GoalTrendService + ChartJsLineAdapter")
    Container(ui, "commitments-ui", "Angular library", "TileShell, MetricHeader, StatusPill, DeltaBadge")
    Container(fw, "dashboard-framework", "Angular library", "TileContext (mode, selectedReviewDate)")
}
ContainerDb(chartjs, "chart.js", "npm package", "Canvas charting")

System_Boundary(svr, "Commitments.Api") {
    Container(api, "GoalProgress trend endpoint", "ASP.NET Core", "/trend")
    ContainerDb(db, "SQL Server", "Goals + Achievements")
}

Rel(user, plugin, "Sees chart")
Rel(plugin, ui, "Composes primitives")
Rel(plugin, fw, "Reads context")
Rel(plugin, chartjs, "Renders canvas")
Rel(plugin, api, "GET /trend", "JSON/HTTPS")
Rel(api, db, "EF Core")

@enduml
