@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Snapshot Push - Per-tile Components

Container_Boundary(api, "API host") {
    Component(evt, "Source events", "ActivityRecorded,\nCommitmentChanged,\nFrequencyChanged,\nToDoChanged", "")
    Component(daily, "DailyResults\nSnapshotPushNotifier", "IHostedService", "")
    Component(weekly, "WeeklyFocus\nSnapshotPushNotifier", "IHostedService", "")
    Component(monthly, "MonthlyProgress\nSnapshotPushNotifier", "IHostedService", "")
    Component(todos, "OutstandingTodos\nSnapshotPushNotifier", "IHostedService", "")
    Component(rel, "Relations\nSnapshotPushNotifier", "IHostedService", "")
    Component(med, "MediatR queries", "shared", "GetXxxSnapshot")
    Component(pub, "IRealtimePublisher", "abstraction", "")
}

Container_Boundary(spa, "SPA tiles") {
    Component(tdaily, "DailyResultsController", "Angular service", "")
    Component(tweekly, "WeeklyFocusController", "Angular service", "")
    Component(tmonthly, "MonthlyProgressController", "Angular service", "")
    Component(ttodos, "OutstandingTodosController", "Angular service", "")
    Component(trel, "RelationsController", "Angular service", "")
}

Rel(evt, daily, "")
Rel(evt, weekly, "")
Rel(evt, monthly, "")
Rel(evt, todos, "")
Rel(evt, rel, "")
Rel(daily, med, "Send")
Rel(weekly, med, "Send")
Rel(monthly, med, "Send")
Rel(todos, med, "Send")
Rel(rel, med, "Send")
Rel(daily, pub, "")
Rel(weekly, pub, "")
Rel(monthly, pub, "")
Rel(todos, pub, "")
Rel(rel, pub, "")
Rel(pub, tdaily, "dailyResultsUpdated")
Rel(pub, tweekly, "weeklyFocusUpdated")
Rel(pub, tmonthly, "monthlyProgressUpdated")
Rel(pub, ttodos, "outstandingTodosUpdated")
Rel(pub, trel, "relationsSummaryUpdated")

@enduml
