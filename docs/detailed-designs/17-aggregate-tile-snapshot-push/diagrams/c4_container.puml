@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Snapshot Push - Containers

System_Boundary(client, "Browser") {
    Container(tiles, "Aggregate tile controllers", "Angular standalone", "snapshot.set(dto)")
}

System_Boundary(server, "Commitments.Api") {
    Container(notif, "<Tile>SnapshotPush\nNotifier x N", "IHostedService", "one per opted-in tile")
    Container(med, "MediatR snapshot queries", "MediatR", "shared with REST")
    Container(pub, "IRealtimePublisher", "Singleton", "envelope")
    Container(hub, "/hub", "SignalR", "profile group")
}

ContainerDb(sql, "SQL Server", "")

Rel(notif, med, "Send(query)")
Rel(med, sql, "EF Core", "SQL")
Rel(notif, pub, "PublishToProfileAsync")
Rel(pub, hub, "SendAsync envelope")
Rel(hub, tiles, "WSS frame")

@enduml
