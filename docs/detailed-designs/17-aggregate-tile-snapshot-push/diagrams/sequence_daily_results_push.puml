@startuml sequence_daily_results_push
!theme plain
skinparam sequenceMessageAlign center

title Daily Results snapshot push (canonical)

actor B as "Editor"
actor A as "Owner"
participant "SaveActivity\nHandler" as SH
participant "InMemoryEventBus" as BUS
participant "DailyResults\nSnapshotPushNotifier" as NOT
participant "GetDailyResults\nSnapshotQuery" as Q
database "SQL" as DB
participant "IRealtimePublisher" as PUB
participant "/hub" as HUB
participant "DailyResults\nController" as TC

B -> SH: SaveActivity
SH -> BUS: ActivityRecordedEvent
BUS -> NOT: HandleAsync
NOT -> Q: Send(GetDailyResultsSnapshotQuery)
Q -> DB: aggregate today
DB --> Q: rows
Q --> NOT: DailyResultsSnapshotDto
NOT -> PUB: PublishToProfileAsync(\n  'dailyResultsUpdated', dto)
PUB -> HUB: SendAsync envelope
HUB -> A: WSS frame
A -> TC: payload arrives
TC -> TC: snapshot.set(dto)
TC --> A: tile re-render (no XHR)

@enduml
