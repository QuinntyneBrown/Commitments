@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title Daily Results Tile - Domain Model

class DailyResultsTileComponent {
  +tileMetadata: TileMetadata
  +goalScope: 'all'|'daily'
  -context: TileContext
  -controller: DailyResultsController
}

class DailyResultsController {
  +snapshot: Signal<DailyResultsDto|null>
  +mode: Signal<DashboardMode>
  +completed: Signal<number>
  +total: Signal<number>
  +percentage: Signal<number>
  +load(mode, asOf): void
}

class DailyResultsService {
  +get(asOf: string|null): Observable<DailyResultsDto>
}

class DailyResultsDto {
  +mode: 'live'|'review'
  +asOf: string
  +date: string
  +completed: number
  +total: number
}

class GetDailyResultsQuery {
  +AsOf: DateTimeOffset?
}

class GetDailyResultsHandler {
  +Handle(q): GetDailyResultsResponse
}

DailyResultsTileComponent o-- DailyResultsController
DailyResultsController --> DailyResultsService
DailyResultsService ..> DailyResultsDto
GetDailyResultsHandler ..> GetDailyResultsQuery

@enduml
