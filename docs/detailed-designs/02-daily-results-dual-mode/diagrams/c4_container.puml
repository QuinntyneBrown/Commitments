@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Daily Results Tile - Containers

Person(user, "User", "Dashboard user")

System_Boundary(spa, "Angular SPA") {
  Container(plugin, "commitments-dashboard-plugin", "Angular lib", "DailyResultsTileComponent + DailyResultsController")
  Container(framework, "dashboard-framework", "Angular lib", "TileContext, bindTileMode")
  Container(invs, "TileInvalidationService", "Angular service", "invalidations$('dailyResults')")
}

System_Boundary(api, "Commitments.Api Host") {
  Container(commit, "Commitments Module", ".NET 9", "GetDailyResultsHandler")
  Container(realtime, "Realtime", "ASP.NET", "DashboardTileInvalidationNotifier")
}

ContainerDb(db, "SQL Server", "RDBMS", "Activities, Commitments")

Rel(user, plugin, "Sees fraction + LIVE/REVIEW pill")
Rel(plugin, framework, "TILE_CONTEXT, bindTileMode")
Rel(plugin, invs, "invalidations$('dailyResults')")
Rel(plugin, commit, "GET /commitment/daily-results?asOf", "JSON")
Rel(commit, db, "Counts via EF Core", "SQL")
Rel(realtime, invs, "SignalR push", "WebSocket")

@enduml
