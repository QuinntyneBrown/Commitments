@startuml sequence_record_activity
!theme plain
skinparam sequenceMessageAlign center

title Record Activity - boundary assertions

actor Spec
participant Po as "ActivitiesPagePo"
participant Browser
participant Page as "ActivitiesPageComponent"
participant Dlg as "EditActivityDialog"
participant Svc as "ActivityService"
participant Mock as "MockDashboardBackendService"
participant Bridge as "WindowFeatureBridgeService"

Spec -> Po: pom.goto()
Po -> Browser: page.goto('/activities')
Browser -> Page: ngOnInit()
Page -> Svc: list()
Svc -> Mock: get('api/v1.0/activities')
Mock -> Bridge: recordBackend(get)

Spec -> Po: pom.openAdd()
Page -> Dlg: open()
Spec -> Dlg: choose commitment, accept default performedOn
Spec -> Dlg: submit
Dlg -> Svc: record({commitmentId, performedOn})
Svc -> Mock: post('api/v1.0/activities', body)
Mock -> Bridge: recordBackend(post)

Spec -> Po: pom.backendCalls()
Po --> Spec: [get, post]
Spec -> Spec: expect post.body.performedOn is ISO

@enduml
