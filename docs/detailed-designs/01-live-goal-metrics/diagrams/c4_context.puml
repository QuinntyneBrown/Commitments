@startuml c4_context
!theme plain
!include <C4/C4_Context>

title Live Goal Metrics - System Context

Person(owner, "Profile Owner", "Tracks personal commitments and goals")

System_Boundary(commitments, "Commitments Platform") {
  System(spa, "Commitments SPA", "Angular dashboard with the Live Goal tile")
  System(api, "Commitments API", "Owns goals, achievements, and the SignalR hub")
}

Rel(owner, spa, "Views live goal progress", "HTTPS")
Rel(spa, api, "GET goal progress + listens for push", "HTTPS / WebSocket")

@enduml
