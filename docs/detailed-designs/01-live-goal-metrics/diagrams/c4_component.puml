@startuml c4_component
!theme plain
!include <C4/C4_Component>

title Live Goal Metrics - Components

Container_Boundary(spa, "Commitments SPA") {
  Component(tile, "LiveGoalMetricsTileComponent", "Angular standalone", "Renders ring + count + LIVE badge")
  Component(ctrl, "LiveGoalMetricsController", "Injectable", "Signals: count, target, pct")
  Component(svc, "GoalProgressService", "Angular service", "HTTP getCurrent(goalId)")
  Component(hub, "HubClient", "Existing", "SignalR client wrapper")
}

Container_Boundary(api, "Commitments.Api") {
  Component(ctl2, "GoalProgressController", "ApiController", "GET /goal-progress/current")
  Component(qh, "GetGoalProgressHandler", "MediatR", "Single EF count query")
  Component(ach, "CreateAchievementHandler", "Existing", "Writes achievement")
  Component(pub, "AchievementCreatedIntegrationHandler", "Existing + 1 line", "Publishes goalProgressUpdated")
}

Rel(tile, ctrl, "Reads signals")
Rel(ctrl, svc, "getCurrent(goalId)")
Rel(ctrl, hub, "on('goalProgressUpdated')")
Rel(svc, ctl2, "GET /api/goal-progress/current")
Rel(ctl2, qh, "Send query")
Rel(ach, pub, "Domain event")
Rel(pub, hub, "SendAsync to profile group")

@enduml
