@startuml c4_container
!theme plain
!include <C4/C4_Container>

title Live Goal Metrics - Containers

Person(owner, "Profile Owner")

System_Boundary(plat, "Commitments Platform") {
  Container(spa, "Commitments SPA", "Angular 19", "Hosts the LiveGoalMetricsTile")
  Container(api, "Commitments.Api", "ASP.NET Core 9", "GoalProgress endpoint + SignalR hub")
  ContainerDb(db, "SQL Server", "EF Core", "Goals, Achievements")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "GET /api/goal-progress/current", "JSON/HTTPS")
Rel(spa, api, "Subscribes to goalProgressUpdated", "WebSocket")
Rel(api, db, "Counts achievements per goal", "SQL")

@enduml
