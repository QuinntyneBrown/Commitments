{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": [
      "jest",
      "node"
    ],
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@app/*": ["projects/commitments-app/src/app/*"],
      "@core/*": ["projects/commitments-app/src/app/core/*"],
      "@models/*": ["projects/commitments-app/src/app/models/*"],
      "@services/*": ["projects/commitments-app/src/app/services/*"],
      "@components/*": ["projects/commitments-app/src/app/components/*"],
      "@pages/*": ["projects/commitments-app/src/app/pages/*"],
      "@commitments/ui": ["projects/commitments-ui/src/public-api.ts"],
      "@commitments/dashboard-framework": ["projects/dashboard-framework/src/public-api.ts"],
      "@commitments/dashboard-plugin": ["projects/commitments-dashboard-plugin/src/public-api.ts"],
      "ag-grid": ["__mocks__/ag-grid"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/test.ts",
    "e2e/**/*"
  ]
}
