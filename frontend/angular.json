{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "commitments-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/commitments-app",
      "sourceRoot": "projects/commitments-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/commitments-app",
            "index": "projects/commitments-app/src/index.html",
            "browser": "projects/commitments-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/commitments-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "projects/commitments-app/src",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/commitments-app/src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "projects/commitments-app/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "commitments-app:build:production"
            },
            "development": {
              "buildTarget": "commitments-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:jest",
          "options": {
            "tsConfig": "projects/commitments-app/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/commitments-app/src/**/*.ts",
              "projects/commitments-app/src/**/*.html"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/commitments-app/.storybook",
            "browserTarget": "commitments-app:build",
            "compodoc": false,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/commitments-app/.storybook",
            "browserTarget": "commitments-app:build",
            "compodoc": false,
            "outputDir": "storybook-static"
          }
        }
      }
    },
