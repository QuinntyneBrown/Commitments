{
  "name": "commitments-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve commitments-app",
    "build": "ng build commitments-ui && ng build dashboard-framework && ng build commitments-dashboard-plugin && ng build commitments-app",
    "build:prod": "ng build commitments-ui --configuration production && ng build dashboard-framework --configuration production && ng build commitments-dashboard-plugin --configuration production && ng build commitments-app --configuration production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"projects/{commitments-app,commitments-ui,dashboard-framework,commitments-dashboard-plugin}/src/**/*.ts\"",
    "lint:fix": "eslint \"projects/{commitments-app,commitments-ui,dashboard-framework,commitments-dashboard-plugin}/src/**/*.ts\" --fix",
    "format": "prettier --write \"projects/{commitments-app,commitments-ui,dashboard-framework,commitments-dashboard-plugin}/src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"projects/{commitments-app,commitments-ui,dashboard-framework,commitments-dashboard-plugin}/src/**/*.{ts,html,scss}\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:report": "playwright show-report",
    "storybook": "ng run commitments-app:storybook",
    "build-storybook": "ng run commitments-app:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@microsoft/signalr": "^8.0.0",
    "@ngx-translate/core": "^16.0.0",
    "@ngx-translate/http-loader": "^16.0.0",
    "angular-gridster2": "^21.0.1",
    "chart.js": "^4.5.1",
    "moment": "^2.30.0",
    "quill": "^2.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/language-service": "^21.0.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/angular": "^8.6.15",
    "@storybook/blocks": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-storybook": "^10.1.10",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.5.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.0",
    "prettier": "^3.2.0",
    "storybook": "^8.6.15",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0",
    "vitest": "^4.0.8"
  }
}
