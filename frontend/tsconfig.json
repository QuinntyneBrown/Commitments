    },
    {
      "path": "./projects/commitments-identity-feature-host/tsconfig.app.json"
    },
    {
      "path": "./projects/commitments-behaviours-feature/tsconfig.lib.json"
    },
    {
      "path": "./projects/commitments-behaviours-feature/tsconfig.spec.json"
    },
    {
      "path": "./projects/commitments-behaviours-feature-host/tsconfig.app.json"
    },
    {
      "path": "./projects/commitments-frequencies-feature/tsconfig.lib.json"
    },
    {
      "path": "./projects/commitments-frequencies-feature/tsconfig.spec.json"
    },
    {
      "path": "./projects/commitments-frequencies-feature-host/tsconfig.app.json"
    },
    {
      "path": "./projects/commitments-commitments-feature/tsconfig.lib.json"
    },
    {
