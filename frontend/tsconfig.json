{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "strict": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ES2022",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ],
    "types": [],
    "paths": {
      "@app/*": [
        "projects/commitments-app/src/app/*"
      ],
      "@core/*": [
        "projects/commitments-app/src/app/core/*"
      ],
      "@models/*": [
        "projects/commitments-app/src/app/models/*"
      ],
      "@services/*": [
        "projects/commitments-app/src/app/services/*"
      ],
      "@components/*": [
        "projects/commitments-app/src/app/components/*"
      ],
      "@pages/*": [
        "projects/commitments-app/src/app/pages/*"
      ],
      "@commitments/dashboard-framework": [
        "projects/dashboard-framework/src/public-api.ts"
      ],
      "@commitments/dashboard-plugin": [
        "projects/commitments-dashboard-plugin/src/public-api.ts"
      ],
      "@commitments/ui": [
        "projects/commitments-ui/src/public-api.ts"
      ],
      "@commitments/identity": [
        "projects/identity/src/public-api.ts"
      ],
      "@commitments-dashboard-plugin-host/*": [
        "projects/commitments-dashboard-plugin-host/src/app/*"
      ],
      "@commitments/identity-feature": [
        "projects/commitments-identity-feature/src/public-api.ts"
      ],
      "@commitments/behaviours-feature": [
        "projects/commitments-behaviours-feature/src/public-api.ts"
      ],
      "@commitments/frequencies-feature": [
        "projects/commitments-frequencies-feature/src/public-api.ts"
      ],
      "@commitments/commitments-feature": [
        "projects/commitments-commitments-feature/src/public-api.ts"
      ],
      "@commitments/tracking-feature": [
        "projects/commitments-tracking-feature/src/public-api.ts"
      ],
      "@commitments/notes-feature": [
        "projects/commitments-notes-feature/src/public-api.ts"
      ],
      "@commitments/cards-feature": [
        "projects/commitments-cards-feature/src/public-api.ts"
      ],
      "@commitments/settings-feature": [
        "projects/commitments-settings-feature/src/public-api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "strictTemplates": false
  },
  "references": [
    {
      "path": "./projects/dashboard-framework/tsconfig.lib.json"
    },
    {
      "path": "./projects/dashboard-framework/tsconfig.spec.json"
    },
    {
      "path": "./projects/commitments-dashboard-plugin/tsconfig.lib.json"
    },
    {
      "path": "./projects/commitments-dashboard-plugin/tsconfig.spec.json"
    },
    {
      "path": "./projects/commitments-ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/commitments-ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/identity/tsconfig.lib.json"
    },
    {
      "path": "./projects/identity/tsconfig.spec.json"
    },
    {
      "path": "./projects/commitments-dashboard-plugin-host/tsconfig.app.json"
    },
    {
      "path": "./projects/commitments-dashboard-plugin-host/tsconfig.spec.json"
    },
    {
