    {
      "path": "./projects/commitments-notes-feature/tsconfig.lib.json"
    },
    {
      "path": "./projects/commitments-notes-feature/tsconfig.spec.json"
    },
    {
      "path": "./projects/commitments-notes-feature-host/tsconfig.app.json"
    },
    {
      "path": "./projects/commitments-cards-feature/tsconfig.lib.json"
    },
    {
      "path": "./projects/commitments-cards-feature/tsconfig.spec.json"
    },
    {
      "path": "./projects/commitments-cards-feature-host/tsconfig.app.json"
    },
    {
      "path": "./projects/commitments-settings-feature/tsconfig.lib.json"
